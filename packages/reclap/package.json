{
  "name": "@rolandpeelen/reclap",
  "version": "0.1.0",
  "description": "Derive command line parsers from ReScript types, in the style of Rust's clap.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolandpeelen/reclap.git",
    "directory": "packages/reclap"
  },
  "homepage": "https://github.com/rolandpeelen/reclap#readme",
  "bugs": {
    "url": "https://github.com/rolandpeelen/reclap/issues"
  },
  "keywords": [
    "rescript",
    "clap",
    "cli",
    "argument-parser",
    "ppx"
  ],
  "files": [
    "src",
    "rescript.json",
    "skills/reclap/SKILL.md",
    "bin",
    "postinstall.js",
    "dune",
    "dune-project",
    "ppx/bin",
    "ppx/lib"
  ],
  "scripts": {
    "postinstall": "node postinstall.js",
    "build:ppx": "dune build",
    "build": "npm run build:ppx && rescript build",
    "clean": "rescript clean && dune clean",
    "format": "rescript format && dune fmt 2>/dev/null || true",
    "test:ppx": "dune test && sh test/ppx/snapshot.sh --check && sh ppx/test/errors/run.sh",
    "test": "npm run build && vitest run && npm run test:ppx",
    "snapshot:ppx": "dune build && sh test/ppx/snapshot.sh",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "rescript": "12.3.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
