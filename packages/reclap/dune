; Only the PPX is an OCaml project. Keep dune away from node_modules and the
; ReScript sources.
(dirs ppx)

; Copy the PPX binary to the package root for the PPX test scripts. Consumers
; use bin/ppx, which finds the dev build or the prebuilt binary.
(rule
 (mode
  (promote (until-clean)))
 (action
  (copy ppx/bin/reclap_ppx.exe ppx.exe)))
